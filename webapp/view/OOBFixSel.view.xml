<mvc:View controllerName="com.sap.lh.mr.zlhoobfix.controller.OOBFixSel"
    xmlns="sap.ui.table"
    xmlns:plugins="sap.ui.table.plugins"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f">
    <f:DynamicPage headerExpanded="true" showFooter="true" stickyHeader="true">
        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <c:Fragment
                        fragmentName="com.sap.lh.mr.zlhoobfix.fragment.selectionHeader"
                        type="XML"
                    />
                    <c:Fragment
                            fragmentName="com.sap.lh.mr.zlhoobfix.fragment.selectionItem"
                            type="XML"
                        /> 
                    <c:Fragment
                            fragmentName="com.sap.lh.mr.zlhoobfix.fragment.SplitApp.splitContent"
                            type="XML"
                        />  
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <!-- <c:Fragment
                            fragmentName="com.sap.lh.mr.zlhoobfix.fragment.selectionItem"
                            type="XML"
                        />                        -->
                        <!-- <c:Fragment
                            fragmentName="com.sap.lh.mr.zlhoobfix.fragment.SplitApp.splitContent"
                            type="XML"
                        />                 -->
        </f:content>    
         <f:footer>
            <m:OverflowToolbar class="customToolbarFontSize">
                <m:ToolbarSpacer />
                <m:Button
                    text="Validate"
                    type="Emphasized"
                    press="onPressValidate"
                    icon="sap-icon://validate"
                    enabled="{= ${OOBFixModel>/IsReleased} !== 'true'}"
                />
                <m:Button
                    text="Save"
                    icon="sap-icon://save"
                    type="Emphasized"
                    press="onPressSave"
                    enabled="{= ${OOBFixModel>/IsReleased} !== 'true'}"
                />
                <m:Button
                    text="Reload"
                    icon="sap-icon://refresh"
                    type="Emphasized"
                    press="onPressRealod"
                    enabled="{= ${OOBFixModel>/IsReleased} !== 'true'}"
                />
                <m:Button
                    text="Reverse Validation"
                    icon="sap-icon://media-reverse"
                    type="Emphasized"
                    visible="true"
                    press="onPressReverseValidate"
                    enabled="{= ${OOBFixModel>/IsReleased} !== 'true'}"
                />
            </m:OverflowToolbar>            
        
        </f:footer>   
    </f:DynamicPage>
</mvc:View>