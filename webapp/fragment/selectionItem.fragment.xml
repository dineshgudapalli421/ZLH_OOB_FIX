<core:FragmentDefinition
    xmlns="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:smarttable="sap.ui.comp.smarttable"
    height="100%"
>
<smarttable:SmartTable 
    id="oobSmartTable"
    entitySet="OOBToolSet"
    tableBindingPath="/OobTooldataSet"
    tableType="ResponsiveTable"
    useVariantManagement="true"
    useTablePersonalisation="true"
    header="OOB Invoices"
    showRowCount="true"
    enableAutoBinding="true"
    enableExport="false"
    demandPopin="true"
    persistencyKey="SmartTableSoFormOOB"
    class="customSmartTableFontSize"
    requestAtLeastFields="Updated,Validated,Reversed,Released,PRINTDOC,AMOUNT_DUE,AmountCalc,OOB_AMOUNT,VKONTO,CustomerName,Reason"
>
    <Table
        id="idTableInvoices"
        rows="{
                    path: '/OobTooldataSet'
                }"
        threshold="5"
        enableBusyIndicator="true"
        ariaLabelledBy="title"
        selectionMode="Single"
        fixedColumnCount="4" 
        class="myCustomSmallTable"
        rowSelectionChange=".onRowSelect"
        rowHeight="20"
    >
    <rowMode>
        <rowmodes:Fixed xmlns:rowmodes="sap.ui.table.rowmodes" rowCount="3" />
    </rowMode>
        <extension>
            <m:OverflowToolbar
                style="Standard"
                width="100%"
                class="customButtonFontSize"
            >
                <m:Title
                    id="title"
                    text="Invoice List"
                    class="customToolbarTitleSize"
                />
                <m:ToolbarSpacer />

                <m:Button
                    text="Proceed"
                    press="onPressNavigate1"
                    type="Emphasized"
                    icon="sap-icon://accept"
                />
                <m:Button
                    id="idReleaseBatchButton"
                    text="Release Batch"
                    press="onReleaseBatch"
                    visible="{SelectionModel>/bReleaseBatchBtn}"
                />
                <m:Button
                    id="idPullListButton"
                    text="Pull List"
                    press="_onPullList"
                    visible="{SelectionModel>/bPullListBtn}"
                />
                <m:Button
                            id="idExport"
                            icon="sap-icon://excel-attachment"
                            tooltip="Download"
                            press="onExport"
                        />
                        <!-- <m:Button
                            editable="true"
                            icon="sap-icon://sort"
                            tooltip="Sort"
                            press="sortInvoices"
                        /> -->
            </m:OverflowToolbar>
        </extension>
        <columns>
            <Column
                autoResizable="true"
                width="3rem"
                sortProperty="Update"
            >
                <m:Label text="Update" />
                <template>
                    <m:CheckBox
                        selected="{= ${Updated}}"
                        editable="false"
                        class="customCheckBoxFontSize"
                    />
                </template>
            </Column>
            <Column
                autoResizable="true"
                width="3rem"
                sortProperty="Validated"
            >
                <m:Label text="Validated" />
                <template>
                    <m:CheckBox
                        selected="{= ${Validated}}"
                        editable="false"
                        class="customCheckBoxFontSize"
                    />
                </template>
            </Column>
            <Column                
                autoResizable="true"
                width="3rem"
                sortProperty="Reversed"
            >
                <m:Label text="Reversed" />
                <template>
                    <m:CheckBox
                        selected="{= ${Reversed}}"
                        editable="false"
                        class="customCheckBoxFontSize"
                    />
                </template>
            </Column>
            <Column
                autoResizable="true"
                width="3rem"
                sortProperty="Released"
            >
                <m:Label text="Released" />
                <template>
                    <m:CheckBox
                        selected="{= ${Released}}"
                        editable="false"
                        class="customCheckBoxFontSize"
                    />
                </template>
            </Column>
            <!-- <Column
                        sortProperty="Name"
                        filterProperty="Name"
                        autoResizable="true"
                        width="3rem"
                    >
                        <m:Label text="Reverse Validation" />
                        <template>
                            <m:CheckBox selected="{OOBFixModel>Checkbox}" />
                        </template>
                    </Column> -->
            <!-- <Column
                autoResizable="true"
                width="6rem"
                hAlign="Center"
                visible="true"
            >
                <m:Label text="Batch ID" />
                <template>
                    <m:Text
                        text="{BatchId}"
                        wrapping="false"
                    />
                </template>
            </Column> -->
            <Column
            id="idInvoice"
                sortProperty="Invoice"
                autoResizable="true"
                hAlign="Center"
                width="7rem"
            >
                <m:Label text="Invoice" />
                <template>
                <m:Link
				text="{PRINTDOC}"
				subtle="true" class="customLinkFontSize"
				press="oInvoiceLinkPress" emphasized="true" textAlign="Center"/>
                    <!-- <m:Text
                        text="{PRINTDOC}"
                        wrapping="false"
                    /> -->
                </template>
            </Column>
            <!-- <Column
                sortProperty="PRINT_DATE"
                autoResizable="true"
                width="11rem"
                hAlign="Center"
                visible="false"
            >
                <m:Label text="Print dt" />
                <template>
                    <m:Text
                        text="{path: 'PRINT_DATE', type: 'sap.ui.model.odata.type.Date'}"
                        wrapping="false"
                    />
                </template>
            </Column> -->
            <Column
                sortProperty="Total Amount"
                autoResizable="true"
                width="5rem"
                hAlign="End"
            >
                <m:Label text="Total Amount" />
                <template>
                    <m:Text
                        text="{path:'AMOUNT_DUE',formatter:'.formatter.Currency'}"
                        wrapping="false"
                    />
                </template>
            </Column>
            <Column
                sortProperty="Tot amt calc"
                autoResizable="true"
                width="5rem"
                hAlign="End"
            >
                <m:Label text="Tot amt calc" />
                <template>
                    <m:Text
                        text="{path:'AmountCalc',formatter:'.formatter.Currency'}"
                        wrapping="false"
                    />
                </template>
            </Column>
            <Column
            sortProperty="Difference"
                autoResizable="true"
                width="5rem"
                hAlign="End"
            >
                <m:Label text="Difference" />
                <template>
                    <m:Text
                        text="{path:'OOB_AMOUNT',formatter:'.formatter.Currency'}"
                        wrapping="false"
                    />
                </template>
            </Column>
            <Column
                hAlign="End"
                sortProperty="Contract Account"
                autoResizable="true"
                width="8rem"
            >
                <m:Label text="Contract Account" />
                <template>
                    <m:Link
				text="{VKONTO}"
				subtle="true" class="customLinkFontSize"
				press="oContractAccountLinkPress" emphasized="true" textAlign="Center"/>
                    <!-- <m:Text
                        text="{VKONTO}"
                        wrapping="false"
                    /> -->
                </template>
            </Column>
            <Column
                sortProperty="Customer Name"
                autoResizable="true"
                width="13rem"
            >
                <m:Label text="Customer Name" />
                <template>
                    <m:Text
                        text="{CustomerName}"
                        wrapping="false"
                        class="customTextFontSize"
                    />
                </template>
            </Column>
            <Column
                sortProperty="Reason"
                autoResizable="true"
                width="28rem"
            >
                <m:Label text="Reason" />
                <template>
                    <m:Text
                        text="{Reason}"
                        wrapping="false"
                        class="customTextFontSize"
                    />
                </template>
            </Column>
        </columns>
    </Table>
    
    </smarttable:SmartTable>
</core:FragmentDefinition>