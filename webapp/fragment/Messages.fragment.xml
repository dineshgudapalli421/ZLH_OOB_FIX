<core:FragmentDefinition
    xmlns="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
>
    <Table
        id="idMessageTable"
        rows="{OOBFixModel>/Message}"
        selectionMode="Single"
        paste="onPaste"
        ariaLabelledBy="title"
        alternateRowColors="true"
        class="myCustomSmallTable"
        visibleRowCount="1"
    >
        <columns>
            <Column width="5rem">
                <m:Label text="Var 1" class="customLabelFontSize"/>
                <template>
                    <m:Label text="{OOBFixModel>Var1}" class="customLabelFontSize"/>
                </template>
            </Column>
            <Column width="5rem">
                <m:Label text="Var 2" class="customLabelFontSize"/>
                <template>
                    <m:Label text="{OOBFixModel>Var2}" class="customLabelFontSize"/>
                </template>
            </Column>
            <!-- <Column
                width="5rem"
                hAlign="End"
            >
                <m:Label text="remove" />
                <template>
                    <m:CheckBox selected="{OOBFixModel>Checkbox}" />
                </template>
            </Column> -->
            <Column>
                <m:Label
                    text="Message"
                    width="15rem"
                    class="customLabelFontSize"
                />
                <template>
                    <m:Input
                        value="{OOBFixModel>Message}"
                        editable="false"
                        class="customInputFontSize"
                    />
                </template>
            </Column>
        </columns>
    </Table>
</core:FragmentDefinition>
